# Copy this file to ".env" and fill in the values. The .env file is git-ignored.

# --- REQUIRED in production ---
# Bootstrap super-admin account created on first run. In Production the server
# refuses to start if these are missing (no insecure default credentials).
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe123!

# --- OPTIONAL ---
# Where persistent data is stored (db.json, sessions.json, data-protection keys).
# Point this at a mounted persistent disk in cloud deployments (e.g. Render).
# Defaults to the ../data folder next to the app.
# DATA_DIR=/var/data

# Business timezone used for "expires today" logic and the daily 08:00 check.
# IANA id. Defaults to Europe/Istanbul.
# APP_TIMEZONE=Europe/Istanbul

# Comma-separated days-before-expiry to send reminder emails on. 0 (expiry day)
# is always included. Defaults to "15,7,1,0". NOTE: the dashboard's "expiring soon"
# colour/threshold is fixed at 15 days (SOON_THRESHOLD_DAYS in the frontend); align
# the largest value here with it so the UI warns when emails start going out.
# REMINDER_DAYS=30,15,7,1,0

# Set to "true" ONLY when the app runs behind a trusted reverse proxy (e.g. Render)
# so it honors X-Forwarded-For for the real client IP (used by rate limiting). Assumes
# exactly one proxy hop. Leave unset for direct exposure — otherwise a client could
# spoof X-Forwarded-For to bypass the login/reset rate limits.
# TRUST_PROXY=true

# Extra CORS origins (comma separated). Not needed when the SPA is served from the
# same origin as the API (the production default). Dev already allows :5173.
# ALLOWED_ORIGINS=https://app.example.com

# Port the server listens on. Cloud hosts (e.g. Render) usually inject this.
# PORT=5001
